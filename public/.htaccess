# FiveGuesses static web build: single-page fallback, caching and security headers (Apache 2.4).
Options -Indexes
AddType application/manifest+json .webmanifest
AddType font/ttf .ttf
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Real files and folders (index.html, /legal/, /_expo/..., /fonts/...) are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https://*.mzstatic.com; media-src https://audio-ssl.itunes.apple.com; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Enable once HTTPS is live for fiveguesses.app (docs/runbook.md step 1):
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  # The bundle and the stylesheets carry their content hash in the name (scripts/build-web.mjs).
  <FilesMatch "[.-][0-9a-f]{32}\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|ttf|woff2|webp)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml font/ttf
</IfModule>
